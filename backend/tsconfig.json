{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "jest"],
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "prisma", "tests", "prisma.config.ts", "../shared"]
}
